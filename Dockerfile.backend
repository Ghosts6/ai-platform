# Use an official Python runtime as a parent image
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

# Set the working directory in the container
WORKDIR /app

# Copy the requirements file and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the backend application source code
COPY ai_agent/ .

# Make the entrypoint script executable
RUN chmod +x entrypoint.sh

# Expose the port the app runs on
EXPOSE 8000

# Set the entrypoint script
ENTRYPOINT ["/app/entrypoint.sh"]

# Run the application with Gunicorn
# We use Gunicorn to run the ASGI application.
# The number of workers can be adjusted based on the server's resources.
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "backend_core.asgi:application", "-k", "uvicorn.workers.UvicornWorker", "--workers", "4"]

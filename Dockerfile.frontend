# Stage 1: Build the React application
FROM node:18-alpine AS build

WORKDIR /app

# Copy package.json and package-lock.json from the frontend directory
COPY frontend/package.json frontend/package-lock.json ./

# Install dependencies
RUN npm install

# Copy the rest of the application source code from the frontend directory
COPY frontend/ .

# Build the application for docker
# This command is derived from the build script in package.json, but without the backend part.
RUN npx react-app-rewired build && npx tailwindcss -i ./src/index.css -o ./dist/css/main.css

# Stage 2: Serve the application using Nginx
FROM nginx:1.21.6-alpine

# Copy the build output from the build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Copy README.md to the nginx root
COPY README.md /usr/share/nginx/html/README.md

# Copy nginx config from the frontend directory
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
